<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591;CA1416</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <DisableDalamudPackager>true</DisableDalamudPackager>
    <RootNamespace>HiAuRo.Helper</RootNamespace>
    <AssemblyName>HiAuRo.Helper</AssemblyName>

    <PackageId>HiAuRo.Helper</PackageId>
    <Version>0.1.1</Version>
    <Authors>denghaoxuan991876906</Authors>
    <Description>FFXIV 全战斗职业数据辅助库 · 基于 HiAuRo.Sdk · 静态 API 开箱即用</Description>
    <PackageTags>FFXIV;Dalamud;ACR;rotation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HiAuRo.Sdk" Version="*">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
